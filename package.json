{
  "name": "ServerStarter2",
  "version": "2.2.0",
  "description": "start Minecraft server only ONE click !",
  "productName": "ServerStarter2",
  "author": "CivilTT, txkodo <serverstarter.contact@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun install --cwd src-electron && quasar prepare",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,json}\" --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "dev": "quasar dev -m electron",
    "dummy": "SRC_DIR=src/dummy quasar dev -m electron",
    "build": "quasar build -m electron"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "browser-image-compression": "^2.0.2",
    "cropperjs": "^2.2.0",
    "mousetrap": "^1.6.5",
    "pinia": "^4.0.3",
    "quasar": "^2.33.2",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@quasar/app-vite": "^3.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/compiler-sfc": "^3.5.43",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "bun@1.3.14"
}
