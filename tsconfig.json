{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["vitest/globals", "vitest/importMeta"]
  },
  "include": [
    "./.quasar/*.d.ts",
    "./env.d.ts",
    "./quasar.config.ts",
    "./src/**/*",
    "./src-electron/**/*",
    "./src-public/**/*",
    "./test/**/*"
  ],
  "exclude": [
    "./dist",
    "./node_modules",
    "./src-electron/node_modules",
    "**/work/**"
  ]
}
