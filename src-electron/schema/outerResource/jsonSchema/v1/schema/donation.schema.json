{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "description": "画像の参照先（配布ファイルからの相対パス・https の URL・data URI のいずれか）"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "言語ごとの文言（キーは ja / en-US）"
          },
          "visible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "color",
          "description",
          "visible"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "services"
  ],
  "additionalProperties": false
}
